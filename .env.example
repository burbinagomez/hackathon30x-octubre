# Nombres, nunca valores. Los valores viven en Railway / entorno local.
# Las credenciales de migraciones (Supabase CLI) viven solo en el GitHub Environment `produccion`.
DATABASE_URL=            # rol app_rt (runtime, sin BYPASSRLS)
CIFRADO_KEY=             # AES-GCM, 32 bytes base64
TYPESAFE_API_KEY=        # Jev (jev-code y jev-router)
CROMA_API_KEY=           # cuenta nueva para el evento
DATOS_GOV_CO_APP_TOKEN=  # opcional; datos.gov.co limita por IP sin token
DATOS_GOV_CO_URL=        # opcional; solo para apuntar a un stub
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
VITE_API_URL=
CORS_ORIGINS=            # dominio público de web, solo en api
E2E_BASE_URL=            # URL pública de web para el E2E
TEST_ADMIN_DATABASE_URL= # solo tests locales/CI (superuser); nunca en Railway
