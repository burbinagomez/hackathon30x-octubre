# Copiá este archivo a local/.env (no se commitea) y completá. Nunca pegues estos valores en un chat.

# Tu usuario local (el único). Con esto entrás en http://localhost:8080.
LOCAL_EMAIL=
LOCAL_PASSWORD=

# 32 bytes en base64. Generá una para local con: openssl rand -base64 32
CIFRADO_KEY=
# Clave del rol app_rt en el Postgres local: openssl rand -hex 16
APP_RT_PASSWORD=

# Opcionales: sin ellas esas partes quedan apagadas (la api arranca igual).
IA_API_KEY=
IA_MODELO=claude-haiku-5-5
# openrouter (con tu key de OpenRouter) o vacío para Anthropic. IA_MODELO_PROVEEDOR: nombre exacto en openrouter.ai/models
IA_PROVEEDOR=
IA_MODELO_PROVEEDOR=
CROMA_API_KEY=
TYPESAFE_API_KEY=
TYPESAFE_URL=

# Email (spec 007). Opcionales: sin ellas `enviar` dice qué falta y /baja responde 404 (la api arranca igual).
# EMAIL_MODO vacío = prueba: solo se manda a EMAIL_PRUEBA_DESTINOS (tus direcciones, separadas por coma).
SMTP_HOST=
SMTP_PORT=
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_SEGURIDAD=
REMITENTE=
# Al menos 32 caracteres. Generá una para local con: openssl rand -hex 32
BAJA_SECRET=
URL_PRIVACIDAD=
EMAIL_MODO=
EMAIL_PRUEBA_DESTINOS=
