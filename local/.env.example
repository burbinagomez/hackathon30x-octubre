# Copiá este archivo a local/.env (no se commitea) y completá. Nunca pegues estos valores en un chat.

# Supabase Auth del proyecto (públicos): URL del proyecto y publishable key (sb_publishable_...).
SUPABASE_URL=https://ouhetsbchchwsyqxwhxb.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Tu usuario de Supabase: Authentication > Users > tu fila > User UID.
LOCAL_AUTH_USER_ID=

# 32 bytes en base64. Generá una para local con: openssl rand -base64 32
CIFRADO_KEY=

# Opcionales: sin ellas esas partes quedan apagadas (la api arranca igual).
IA_API_KEY=
IA_MODELO=
CROMA_API_KEY=
TYPESAFE_API_KEY=
TYPESAFE_URL=
